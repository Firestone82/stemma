<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stemma family tree file format, version 1.x (this schema describes 1.9).

  Compatibility rules:
  * The namespace never changes between versions.
  * formatVersion="MAJOR.MINOR". Minor versions only add optional elements and
    attributes. Readers ignore what they do not understand and write it back.
  * 1.9 has one way of drawing the tree and one print style. The settings of the
    earlier ways of drawing (styles, the drawn tree, generations in rows, stacked
    couples, sideways branches, relationship names, portraits), <background> and
    <arrangement> are no longer part of the format: a reader ignores them and
    does not write them back. People and families are unchanged.
  * Elements and attributes from other namespaces are allowed almost anywhere,
    so other tools can attach their own data.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:stemma:family-tree"
           targetNamespace="urn:stemma:family-tree"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.9">

  <xs:element name="familyTree" type="t:FamilyTree">
    <xs:key name="personId">
      <xs:selector xpath="t:people/t:person"/>
      <xs:field xpath="@id"/>
    </xs:key>
    <xs:key name="familyId">
      <xs:selector xpath="t:families/t:family"/>
      <xs:field xpath="@id"/>
    </xs:key>
    <xs:keyref name="partnerRef" refer="t:personId">
      <xs:selector xpath="t:families/t:family/t:partner"/>
      <xs:field xpath="@ref"/>
    </xs:keyref>
    <xs:keyref name="childRef" refer="t:personId">
      <xs:selector xpath="t:families/t:family/t:child"/>
      <xs:field xpath="@ref"/>
    </xs:keyref>
    <xs:keyref name="homePersonRef" refer="t:personId">
      <xs:selector xpath="t:meta/t:homePerson"/>
      <xs:field xpath="@ref"/>
    </xs:keyref>
    <xs:keyref name="printCenterRef" refer="t:personId">
      <xs:selector xpath="t:print"/>
      <xs:field xpath="@center"/>
    </xs:keyref>
    <xs:keyref name="savedPrintCenterRef" refer="t:personId">
      <xs:selector xpath="t:savedPrints/t:print"/>
      <xs:field xpath="@center"/>
    </xs:keyref>
    <xs:keyref name="printPartnerRef" refer="t:personId">
      <xs:selector xpath="t:print"/>
      <xs:field xpath="@partner"/>
    </xs:keyref>
    <xs:keyref name="movePersonRef" refer="t:personId">
      <xs:selector xpath="t:arrangement/t:move"/>
      <xs:field xpath="@person"/>
    </xs:keyref>
    <xs:keyref name="lineFamilyRef" refer="t:familyId">
      <xs:selector xpath="t:arrangement/t:line"/>
      <xs:field xpath="@family"/>
    </xs:keyref>
    <xs:keyref name="coupleFamilyRef" refer="t:familyId">
      <xs:selector xpath="t:arrangement/t:couple"/>
      <xs:field xpath="@family"/>
    </xs:keyref>
    <xs:keyref name="coupleLeftRef" refer="t:personId">
      <xs:selector xpath="t:arrangement/t:couple"/>
      <xs:field xpath="@left"/>
    </xs:keyref>
    <xs:keyref name="surnameFamilyRef" refer="t:familyId">
      <xs:selector xpath="t:people/t:person/t:name"/>
      <xs:field xpath="@surnameFrom"/>
    </xs:keyref>
  </xs:element>

  <!-- Simple types -->

  <xs:simpleType name="Id">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9._\-]*"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="FormatVersion">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+(\.\d+){0,2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A calendar date that may be truncated to a month or a year. -->
  <xs:simpleType name="PartialDate">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\d|3[01]))?)?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Sex">
    <xs:restriction base="xs:string">
      <xs:enumeration value="female"/>
      <xs:enumeration value="male"/>
      <xs:enumeration value="other"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DateQualifier">
    <xs:restriction base="xs:string">
      <xs:enumeration value="about"/>
      <xs:enumeration value="before"/>
      <xs:enumeration value="after"/>
      <xs:enumeration value="estimated"/>
      <xs:enumeration value="calculated"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FamilyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="marriage"/>
      <xs:enumeration value="partnership"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ChildRelation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="biological"/>
      <xs:enumeration value="adopted"/>
      <xs:enumeration value="foster"/>
      <xs:enumeration value="step"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EndReason">
    <xs:restriction base="xs:string">
      <xs:enumeration value="divorce"/>
      <xs:enumeration value="separation"/>
      <xs:enumeration value="annulment"/>
      <xs:enumeration value="death"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>





  <!-- 1.1: a BCP 47 language tag such as "en" or "cs". -->
  <xs:simpleType name="Language">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 1.1 -->
  <!-- 1.9: a place on the page or in a box: a corner, the middle of a side, the middle. -->
  <xs:simpleType name="Anchor">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top-left"/>
      <xs:enumeration value="top"/>
      <xs:enumeration value="top-right"/>
      <xs:enumeration value="left"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="right"/>
      <xs:enumeration value="bottom-left"/>
      <xs:enumeration value="bottom"/>
      <xs:enumeration value="bottom-right"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Orientation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="auto"/>
      <xs:enumeration value="portrait"/>
      <xs:enumeration value="landscape"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 1.1: a number of generations, or "all". -->
  <xs:simpleType name="Reach">
    <xs:restriction base="xs:string">
      <xs:pattern value="all|\d{1,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Content from other namespaces, allowed at the end of most elements. -->
  <xs:group name="Foreign">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- Document -->

  <xs:complexType name="FamilyTree">
    <xs:sequence>
      <xs:element name="meta" type="t:Meta"/>
      <xs:element name="view" type="t:View" minOccurs="0"/>
      <xs:element name="people" type="t:People"/>
      <xs:element name="families" type="t:Families"/>
      <!-- 1.1 -->
      <xs:element name="print" type="t:Print" minOccurs="0"/>
      <!-- 1.9: print settings kept for particular people, one <print> for each, named by its center. -->
      <xs:element name="savedPrints" type="t:SavedPrints" minOccurs="0"/>
      <xs:group ref="t:Foreign"/>
    </xs:sequence>
    <xs:attribute name="formatVersion" type="t:FormatVersion" use="required"/>
    <xs:attribute name="generator" type="xs:string"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="SavedPrints">
    <xs:sequence>
      <xs:element name="print" type="t:Print" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Meta">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:element name="created" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="modified" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="homePerson" type="t:Reference" minOccurs="0"/>
      <xs:group ref="t:Foreign"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <!--
    What the cards show (1.9), on the chart and in prints alike. Every attribute is optional.
    showEmblems: the shield with the initials in the family's colour. showBirthNames: the surname
    at birth under the surname. dates: none, years, or in full where they fit. showSex: the sex
    as a symbol. sexColors: the sex as an accent down the card's edge. showRibbons: a ribbon across
    the corner of someone who has died (white for a child who died at birth). The badge on a card
    whose record has a mistake is not a setting: it is always on the chart and never in a print.
  -->
  <xs:attributeGroup name="Cards">
    <xs:attribute name="showEmblems" type="xs:boolean" default="true"/>
    <xs:attribute name="showBirthNames" type="xs:boolean" default="true"/>
    <!-- 1.9: with the surnames at birth, "née Unknown" for a married woman who bears her husband's name and whose own is not known. -->
    <xs:attribute name="unknownBirthNames" type="xs:boolean" default="true"/>
    <xs:attribute name="dates" type="t:DateStyle" default="years"/>
    <xs:attribute name="showSex" type="xs:boolean" default="true"/>
    <xs:attribute name="sexColors" type="xs:boolean" default="true"/>
    <xs:attribute name="showRibbons" type="xs:boolean" default="true"/>
  </xs:attributeGroup>

  <xs:simpleType name="PositiveNumber">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DateStyle">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="years"/>
      <xs:enumeration value="full"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- How the chart is drawn. Every attribute is optional and has a default. -->
  <xs:complexType name="View">
    <xs:group ref="t:Foreign"/>
    <xs:attributeGroup ref="t:Cards"/>
    <!-- 1.1: the language of the words on the chart when the tree was saved. -->
    <xs:attribute name="language" type="t:Language" default="en"/>
    <!-- 1.4: how far out to the sides the chart reaches: 0 the direct line, 1 siblings, aunts and uncles, 2 first cousins, all. -->
    <xs:attribute name="branches" type="t:Reach" default="all"/>
    <!-- 1.4: with branches="all", whether the families of those who married in are shown too. -->
    <xs:attribute name="inLawFamilies" type="xs:boolean" default="true"/>
    <!-- 1.6: with branches="1", brothers and sisters only, without aunts, uncles, nieces and nephews. -->
    <xs:attribute name="siblingsOnly" type="xs:boolean" default="false"/>
    <!-- 1.9: the Polish and the Czech spelling of a surname count as one family (Nowak and Novák). -->
    <xs:attribute name="uniteSpellings" type="xs:boolean" default="true"/>
    <!-- 1.9: the German and the Czech spelling of a surname count as one family too (Schmidt and Šmíd). -->
    <xs:attribute name="uniteForeign" type="xs:boolean" default="true"/>
    <!-- 1.9: on the chart, a soft background in each family's colour behind its cards. -->
    <xs:attribute name="familyBackgrounds" type="xs:boolean" default="false"/>
    <!-- 1.1, and again in 1.9: on the chart's cards, how everyone is related to the person the tree is centred on. -->
    <xs:attribute name="showRelationships" type="xs:boolean" default="true"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <!--
    1.1: how the tree is printed. paper is an open list (a newer version may add paper sizes);
    an unknown value is kept and drawn on A3.
  -->
  <xs:complexType name="Print">
    <xs:group ref="t:Foreign"/>
    <xs:attributeGroup ref="t:Cards"/>
    <xs:attribute name="paper" type="xs:string" default="A3"/>
    <xs:attribute name="orientation" type="t:Orientation" default="auto"/>
    <!-- The person the page is drawn around (the home person when absent) and their partner beside them. -->
    <xs:attribute name="center" type="t:Id"/>
    <xs:attribute name="partner" type="t:Id"/>
    <xs:attribute name="withPartner" type="xs:boolean" default="true"/>
    <!-- 1.9: families as close together as they go, with the least room between cards and lines. -->
    <xs:attribute name="tight" type="xs:boolean" default="false"/>
    <!-- 1.9: the gap between cards side by side, and how far lines keep from cards, in hundredths of a card's width. -->
    <xs:attribute name="cardGap" type="xs:decimal"/>
    <xs:attribute name="lineGap" type="xs:decimal"/>
    <!-- 1.9: a much longer search for the arrangement of the families that leaves the least of the page empty. -->
    <xs:attribute name="fill" type="xs:boolean" default="false"/>
    <!-- 1.9: in a column of children, a couple with nobody under them stands one over the other; otherwise every couple stands side by side. -->
    <xs:attribute name="stackCouples" type="xs:boolean" default="false"/>
    <!-- 1.9: a heading with an ornament over the families' names. -->
    <xs:attribute name="legendHeading" type="xs:boolean" default="true"/>
    <!-- 1.9: where the heading stands over the families' names. -->
    <xs:attribute name="legendHeadAlign" default="center">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="left"/>
          <xs:enumeration value="center"/>
          <xs:enumeration value="right"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <!-- 1.9: the title and the families' names keep a place of their own that no card stands on; false: the tree is fitted to the whole page. -->
    <!-- 1.9: how wide the heading over the families' names is, in centimetres. -->
    <xs:attribute name="legendHeadWidth" type="xs:decimal"/>
    <xs:attribute name="legendBlocks" type="xs:boolean" default="false"/>
    <!-- 1.9: a second page after the print that lists its settings. -->
    <xs:attribute name="settingsPage" type="xs:boolean" default="true"/>
    <!-- 1.9: which of the arrangements offered (when several fit about as well) is taken; 0 (absent) is the one with the biggest cards. -->
    <xs:attribute name="layoutChoice" type="xs:positiveInteger"/>
    <!-- 1.9: someone with several partners stands between them; false keeps the partners of a family that hangs at the side of a line all on one side. -->
    <xs:attribute name="amidPartners" type="xs:boolean" default="true"/>
    <!-- 1.9: the words on the cards a size bigger, the cards taller for it. -->
    <xs:attribute name="largeText" type="xs:boolean" default="false"/>
    <!-- 1.9: the lines between the cards heavier and the marks between partners bigger. -->
    <xs:attribute name="strongLines" type="xs:boolean" default="false"/>
    <!-- 1.9: a card whose names do not fit it is as wide as they need; the others keep the one width, all the one height. -->
    <xs:attribute name="freeWidths" type="xs:boolean" default="false"/>
    <!-- 1.9: the families' names held at a place on the page inside its margin, whatever size they are: with legendBox, a box of that size; without, a block just big enough for them. -->
    <xs:attribute name="legendAnchor" type="t:Anchor"/>
    <!-- 1.9: where the names stand in a box bigger than they need (legendBox). In the middle when absent. -->
    <xs:attribute name="legendAlign" type="t:Anchor"/>
    <!-- 1.9: the title held at a place on the page inside its margin (titleAt is then not used). Top middle when neither is there. -->
    <xs:attribute name="titleAnchor" type="t:Anchor"/>
    <!-- 1.9: how each couple stands, as a word at their marker ("married", "divorced"). -->
    <xs:attribute name="unionText" type="xs:boolean" default="false"/>
    <!-- 1.9: the title moved by hand: "x y", the middle of it across and its top, as shares of the page. -->
    <xs:attribute name="titleAt" type="xs:string"/>
    <!-- 1.9: cards moved by hand: "I12:30,-14.5 I40:0,66", each a person and how far right and down from where the layout puts the card, in the layout's units (a card is about 190 wide). -->
    <xs:attribute name="moves" type="xs:string"/>
    <!-- 1.9: lines led by hand, "family|child:x,y;x,y;…" with a space between lines, in the layout's units. -->
    <xs:attribute name="lineBends" type="xs:string"/>
    <!-- 1.9: gaps between two cards made wider by hand, "left|right:by" (or "upper|lower:by") with a space between gaps, in the layout's units. -->
    <xs:attribute name="gaps" type="xs:string"/>
    <!-- 1.9: people brought onto the print by hand, whatever the reach leaves out: "I12 I13 I40", their ids. -->
    <xs:attribute name="added" type="xs:string"/>
    <!-- 1.9: people whose partners stand on the other side of them: "I11 I40", their ids. -->
    <xs:attribute name="flipped" type="xs:string"/>
    <xs:attribute name="ancestors" type="t:Reach" default="all"/>
    <xs:attribute name="descendants" type="t:Reach" default="all"/>
    <xs:attribute name="branches" type="t:Reach" default="all"/>
    <xs:attribute name="inLawFamilies" type="xs:boolean" default="true"/>
    <xs:attribute name="siblingsOnly" type="xs:boolean" default="false"/>
    <xs:attribute name="title" type="xs:string"/>
    <xs:attribute name="subtitle" type="xs:string"/>
    <!-- 1.9: the parts of the page: the title across the top, the families' names, the frame. -->
    <xs:attribute name="showTitle" type="xs:boolean" default="true"/>
    <xs:attribute name="showLegend" type="xs:boolean" default="true"/>
    <xs:attribute name="showFrame" type="xs:boolean" default="true"/>
    <!-- 1.6: people hidden from prints are printed all the same. -->
    <xs:attribute name="showHidden" type="xs:boolean" default="false"/>
    <!-- 1.8: the PDF in pieces on sheets of this paper, to be glued together; borderless: the printer prints to the edge. -->
    <xs:attribute name="tiles" type="xs:string"/>
    <xs:attribute name="tilesBorderless" type="xs:boolean" default="false"/>
    <!-- 1.8: the line height of the title and of the families' names on paper, in centimetres. -->
    <xs:attribute name="titleSize" type="t:PositiveNumber"/>
    <xs:attribute name="legendSize" type="t:PositiveNumber"/>
    <!-- 1.9: how far the families' names held at the top (or the foot) keep from the title there, in centimetres; 0.5 when absent. -->
    <xs:attribute name="legendGap" type="xs:decimal"/>
    <!-- 1.8: the families' names placed by hand: "x y w h", shares of the page's width and height. -->
    <xs:attribute name="legendBox" type="xs:string"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="People">
    <xs:sequence>
      <xs:element name="person" type="t:Person" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="t:Foreign"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="Families">
    <xs:sequence>
      <xs:element name="family" type="t:Family" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="t:Foreign"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <!-- People -->

  <xs:complexType name="Person">
    <xs:sequence>
      <xs:element name="name" type="t:Name"/>
      <xs:element name="birth" type="t:Event" minOccurs="0"/>
      <!-- Present when the person has died, even with no date or place. -->
      <xs:element name="death" type="t:Event" minOccurs="0"/>
      <xs:element name="occupation" type="xs:string" minOccurs="0"/>
      <xs:element name="photo" type="t:Photo" minOccurs="0"/>
      <xs:element name="notes" type="xs:string" minOccurs="0"/>
      <xs:group ref="t:Foreign"/>
    </xs:sequence>
    <xs:attribute name="id" type="t:Id" use="required"/>
    <xs:attribute name="sex" type="t:Sex" default="unknown"/>
    <!-- 1.6: "hidden" leaves the person out of prints; they stay on the chart. -->
    <xs:attribute name="print" type="t:PersonPrint"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <xs:simpleType name="PersonPrint">
    <xs:restriction base="xs:string">
      <xs:enumeration value="hidden"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Name">
    <xs:group ref="t:Foreign"/>
    <xs:attribute name="given" type="xs:string"/>
    <!-- Nobody knows the given name (1.7). -->
    <xs:attribute name="givenUnknown" type="xs:boolean"/>
    <xs:attribute name="surname" type="xs:string"/>
    <!--
      1.9: for a woman married more than once whose surname is not written in, the marriage (the family's id)
      whose husband's surname she bears; without it, she bears her current husband's.
    -->
    <xs:attribute name="surnameFrom" type="t:Id"/>
    <!-- The surname at birth when it differs from the current one ("née"). -->
    <xs:attribute name="birthSurname" type="xs:string"/>
    <xs:attribute name="nickname" type="xs:string"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <!-- A dated event. Use dateText for dates that are not calendar dates ("Easter 1902"). -->
  <xs:complexType name="Event">
    <xs:group ref="t:Foreign"/>
    <xs:attribute name="date" type="t:PartialDate"/>
    <xs:attribute name="dateQualifier" type="t:DateQualifier"/>
    <xs:attribute name="dateText" type="xs:string"/>
    <!-- Nobody knows when it was (1.7). -->
    <xs:attribute name="dateUnknown" type="xs:boolean"/>
    <xs:attribute name="place" type="xs:string"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="EndEvent">
    <xs:complexContent>
      <xs:extension base="t:Event">
        <xs:attribute name="reason" type="t:EndReason"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Either embedded base64 data with a media type, or an href. -->
  <xs:complexType name="Photo">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="mediaType" type="xs:string"/>
        <xs:attribute name="encoding" type="xs:string" fixed="base64"/>
        <xs:attribute name="href" type="xs:anyURI"/>
        <xs:anyAttribute namespace="##other" processContents="lax"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="Family">
    <xs:sequence>
      <xs:element name="partner" type="t:Reference" minOccurs="0" maxOccurs="2"/>
      <xs:element name="start" type="t:Event" minOccurs="0"/>
      <xs:element name="end" type="t:EndEvent" minOccurs="0"/>
      <!-- In birth order. -->
      <xs:element name="child" type="t:Child" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="notes" type="xs:string" minOccurs="0"/>
      <!-- 1.1: when the couple got engaged. Engaged and not married yet: type="partnership". -->
      <xs:element name="engagement" type="t:Event" minOccurs="0"/>
      <xs:group ref="t:Foreign"/>
    </xs:sequence>
    <xs:attribute name="id" type="t:Id" use="required"/>
    <!-- 1.9: the day the family's data was confirmed as right in the review (YYYY-MM-DD). -->
    <xs:attribute name="checked" type="xs:date"/>
    <xs:attribute name="type" type="t:FamilyType" default="marriage"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="Reference">
    <xs:attribute name="ref" type="t:Id" use="required"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="Child">
    <xs:group ref="t:Foreign"/>
    <xs:attribute name="ref" type="t:Id" use="required"/>
    <xs:attribute name="relation" type="t:ChildRelation" default="biological"/>
    <!-- 1.3: children of one family with the same value were born together (twins, triplets). -->
    <xs:attribute name="birthGroup" type="xs:token"/>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>
</xs:schema>
